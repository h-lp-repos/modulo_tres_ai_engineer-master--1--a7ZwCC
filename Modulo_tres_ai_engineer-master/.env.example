# Copiar a .env y completar. NUNCA subir el .env al repo.
OPENAI_API_KEY=sk-...

# Modelo de chat del agente (tool calling). Debe existir en pricing.json
OPENAI_MODEL=gpt-4.1-mini

# Poner en 1 para correr TODO sin API key ni costo: el "modelo" es un guion determinista
# (orbitair/mock_agente.py) que elige herramientas con reglas. Sirve para ensayar el loop,
# las stopping rules, los errores, la memoria y el grafo; NO para juzgar la calidad del agente.
ORBITAIR_MOCK=1

# C5 · Langfuse (opcional). Con estas tres variables, las trazas, scores y experimentos se mandan también a
# Langfuse (Cloud: crear un proyecto gratis en https://cloud.langfuse.com y copiar las claves de Settings > API Keys;
# o un Langfuse self-hosted, cambiando la URL). Sin ellas, todo queda local en results/c5_trazas.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# ORBITAIR_TRAZAS=local        # fuerza el modo local aunque haya claves
